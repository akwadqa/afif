  "message": "<p style=\"text-align: left;\">Dear {{ doc.ar_name }}</p>\r\n<p style=\"text-align: left;\">ID Number: {{ doc.ben_primary_idnumber }}</p>\r\n\r\n<p style=\"text-align: left;\"> your registration request has been <strong>Accepted</strong> as beneficiary. Please submit your help request as needed.</p>\r\n<p style=\"text-align: left;\">Please visit the following link and follow the instructions:</p>\r\n<p style=\"text-align: left;\"><a href=\"https://erp.afif.qa/\" target=\"_blank\">https://erp.afif.qa/</a></p>\r\n\r\n<p style=\"text-align: left;\">Best regards,</p>\r\n<p style=\"text-align: left;\">Afif Support Team.</p>\r\n\r\n\r\n<p style=\"text-align: right;\">\u0639\u0632\u064a\u0632\u064a {{ doc.ar_name }}</p>\r\n<p style=\"text-align: right;\">\u0627\u0644\u0631\u0642\u0645: {{ doc.ben_primary_idnumber }}</p>\r\n\r\n<p style=\"text-align: right;\"> \u062a\u0645 <strong>\u0642\u0628\u0648\u0644</strong> \u062a\u0633\u062c\u064a\u0644\u0643\u0645 \u0641\u064a \u0645\u0648\u0642\u0639 \u0645\u0624\u0633\u0633\u0629 \u0639\u0641\u064a\u0641 \u0627\u0644\u062e\u064a\u0631\u064a\u0629 \u0643\u0645\u0633\u062a\u0641\u064a\u062f\u060c \u064a\u0631\u062c\u0649 \u062a\u0633\u062c\u064a\u0644 \u0637\u0644\u0628 \u0645\u0633\u0627\u0639\u062f\u0629 \u0645\u0646 \u0623\u064a\u0642\u0648\u0646\u0629 \u0637\u0644\u0628 \u0627\u0644\u0645\u0633\u0627\u0639\u062f\u0629</p>\r\n<p style=\"text-align: right;\">\u0627\u0644\u0631\u062c\u0627\u0621 \u0632\u064a\u0627\u0631\u0629 \u0627\u0644\u0631\u0627\u0628\u0637 \u0627\u0644\u062a\u0627\u0644\u064a \u0648\u0627\u062a\u0628\u0627\u0639 \u0627\u0644\u062a\u0639\u0644\u064a\u0645\u0627\u062a:</p>\r\n<p style=\"text-align: right;\"><a href=\"https://erp.afif.qa/\" target=\"_blank\">https://erp.afif.qa/</a></p>\r\n\r\n<p style=\"text-align: right;\">\u0645\u0639 \u0641\u0627\u0626\u0642 \u0627\u0644\u0627\u062d\u062a\u0631\u0627\u0645\u060c</p>\r\n<p style=\"text-align: right;\">\u0641\u0631\u064a\u0642 \u062f\u0639\u0645 \u0639\u0641\u064a\u0641</p>\r\n",
