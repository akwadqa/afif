  "message": "<p style=\"text-align: left;\">Dear {{ frappe.db.get_value(\"Beneficiaries Registration\", doc.beneficiaries, \"en_name\") }}</p>\r\n<p style=\"text-align: left;\">ID: {{doc.personal_id}}</p>\r\n<p style=\"text-align: left;\">Important; To complete your application review process, please visit Afif Charity within a maximum of 3 days from the your application submission date, to sign the Data Privacy Declaration. </p>\r\n<p style=\"text-align: left;\">\r\n\r\n  <a href=\"https://www.google.com/maps/place/Afif+Charity/@25.2541336,51.5123719,15z/data=!4m6!3m5!1s0x3e45da1f4ece207d:0xe3ad5480ac8506fe!8m2!3d25.2541336!4d51.5123719!16s%2Fg%2F11c53305zv?sa=X&ved=2ahUKEwjenaqz4uf9AhX-iv0HHa-KCjAQ_BJ6BAhbEAg&coh=164777&entry=tt&shorturl=1\">Location</a>\r\n</p>\r\n\r\n\r\n<p style=\"text-align: right;\">\u0639\u0632\u064a\u0632\u0649: {{ frappe.db.get_value(\"Beneficiaries Registration\", doc.beneficiaries, \"ar_name\") }}</p>\r\n<p style=\"text-align: right;\">\u0627\u0644\u0631\u0642\u0645: {{doc.personal_id}}</p>\r\n<p style=\"text-align: right;\">\u0644\u0644\u0623\u0647\u0645\u064a\u0629 \u0648\u0644\u0625\u062a\u0645\u0627\u0645 \u0625\u062c\u0631\u0627\u0621\u0627\u062a \u062f\u0631\u0627\u0633\u0629 \u0627\u0644\u0637\u0644\u0628 \u064a\u0631\u062c\u0649 \u0627\u0644\u062d\u0636\u0648\u0631 \u0644\u0645\u0624\u0633\u0633\u0629 \u0639\u0641\u064a\u0641 \u0627\u0644\u062e\u064a\u0631\u064a\u0629 \u062e\u0644\u0627\u0644 3 \u0623\u064a\u0627\u0645 \u0645\u0646 \u062a\u0627\u0631\u064a\u062e \u062a\u0642\u062f\u064a\u0645 \u0627\u0644\u0637\u0644\u0628 (\u0628\u062d\u062f \u0623\u0642\u0635\u0649) \u0644\u062a\u0648\u0642\u064a\u0639 \u0625\u0642\u0631\u0627\u0631 \u062e\u0635\u0648\u0635\u064a\u0629 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a. </p>\r\n<p style=\"text-align: right;\">\r\n\r\n  <a href=\"https://www.google.com/maps/place/Afif+Charity/@25.2541336,51.5123719,15z/data=!4m6!3m5!1s0x3e45da1f4ece207d:0xe3ad5480ac8506fe!8m2!3d25.2541336!4d51.51