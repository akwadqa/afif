  "message": "<p style=\"text-align: left;\">Dear {{ frappe.db.get_value(\"Beneficiaries Registration\", doc.beneficiaries, \"en_name\") }}</p>\r\n<p style=\"text-align: left;\">ID: {{doc.personal_id}}</p>\r\n<p style=\"text-align: left;\">Dear applicant your registration request has been  <strong>Rejected</strong>, . (if you are in need) you can apply again after 3 months from now.</p>\r\n\r\n<p style=\"text-align: right;\">\u0639\u0632\u064a\u0632\u0649: {{ frappe.db.get_value(\"Beneficiaries Registration\", doc.beneficiaries, \"ar_name\") }}</p>\r\n<p style=\"text-align: right;\">: {{doc.personal_id}}</p>\r\n\r\n<p style=\"text-align: right;\">\r\n    \u0646\u0639\u062a\u0630\u0631\u060c <strong>\u062a\u0645 \u0631\u0641\u0636</strong> \u0637\u0644\u0628 \u0627\u0644\u0645\u0633\u0627\u0639\u062f\u0629 \u0627\u0644\u0645\u0642\u062f\u0645 \u0645\u0646 \u0642\u0628\u0644\u0643\u0645 \u0648\u062a\u0642\u0631\u0631 \u062d\u0641\u0638 \u0627\u0644\u0645\u0644\u0641. (\u0641\u064a \u062d\u0627\u0644 \u0627\u0644\u062d\u0627\u062c\u0629) \u064a\u0645\u0643\u0646\u0643 \u0627\u0644\u062a\u0642\u062f\u064a\u0645 \u0639\u0644\u0649 \u0637\u0644\u0628 \u0645\u0633\u0627\u0639\u062f\u0629 \u062c\u062f\u064a\u062f \u0628\u0639\u062f 3 \u0623\u0634\u0647\u0631 \u0645\u0646 \u062a\u0627\u0631\u064a\u062e\u0647.\r\n</p>\r\n",
